# Maintainer: Shokunin <https://repo.ceereals.space>
#
# shokunin-branding — visual identity assets for Shokunin.
#
# Ships:
#   /etc/os-release                                  (overwrites the upstream one)
#   /usr/share/backgrounds/shokunin/wallpaper.png    (default wallpaper)
#   /usr/share/plymouth/themes/shokunin/             (boot splash theme)
#   /usr/share/grub/themes/shokunin/                 (GRUB theme)
#
# Real assets are NOT in the repo at scaffolding time. See the README
# next to each subdirectory for what to drop in.

# shellcheck disable=SC2034,SC2154
# (makepkg contract: pkgname/pkgver/... are consumed by makepkg; srcdir
# and pkgdir are injected at build time.)

pkgname=shokunin-branding
pkgver=0.1.0
pkgrel=1
pkgdesc="Shokunin branding: wallpaper, plymouth and GRUB themes, /etc/os-release"
arch=('any')
url="https://repo.ceereals.space"
license=('CC-BY-SA-4.0')

# We overwrite /etc/os-release so the user can `cat /etc/os-release`
# and see Shokunin. `filesystem` owns the canonical one; declare the
# conflict so pacman knows to back theirs up to .pacsave on install.
conflicts=()
provides=()
# `install -Dm644 ... /etc/os-release` would normally collide with the
# `filesystem` package on a fresh system. We use `backup=` so user
# modifications are preserved across upgrades.
backup=('etc/os-release')

# Files live next to the PKGBUILD. `source=()` uses bare filenames so
# makepkg copies them from the package directory.
source=(
  'os-release'
  'wallpaper.png'      # placeholder; see README in this directory
  'plymouth/'          # directory: drop theme files here (see plymouth/README.md)
  'grub/'              # directory: drop theme files here (see grub/README.md)
)
# At scaffolding time the placeholder files are absent or empty; skip
# the integrity check so PKGBUILD parses with `makepkg --printsrcinfo`.
# Once real assets land, replace these with `sha256sums=('...')`.
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # /etc/os-release — Shokunin identity for scripts and detection.
  install -Dm644 "${srcdir}/os-release" "${pkgdir}/etc/os-release"

  # Wallpaper — referenced from the default Quickshell config.
  install -Dm644 "${srcdir}/wallpaper.png" \
    "${pkgdir}/usr/share/backgrounds/shokunin/wallpaper.png"

  # Plymouth theme — boot splash. plymouth-set-default-theme(1) is run
  # by the user (or a Calamares hook) post-install.
  install -d "${pkgdir}/usr/share/plymouth/themes/shokunin"
  cp -r "${srcdir}/plymouth/." "${pkgdir}/usr/share/plymouth/themes/shokunin/"

  # GRUB theme — referenced via GRUB_THEME in /etc/default/grub. The
  # post-install hook is left to the user; the package only ships
  # assets, not config edits.
  install -d "${pkgdir}/usr/share/grub/themes/shokunin"
  cp -r "${srcdir}/grub/." "${pkgdir}/usr/share/grub/themes/shokunin/"
}
