# Maintainer: Shokunin <https://repo.ceereals.space>
#
# shokunin-keyring — ships the GPG public key(s) used to sign packages in
# the [shokunin] pacman repo, and registers them in the system keyring on
# install.
#
# Modelled on `archlinux-keyring` and `cachyos-keyring`: the package
# installs the keyring file under /usr/share/pacman/keyrings/, and the
# `*.install` script tells pacman-key to import + lsign it.

# shellcheck disable=SC2034,SC2154

pkgname=shokunin-keyring
pkgver=20260101
pkgrel=1
pkgdesc="Shokunin repo signing keys for pacman"
arch=('any')
url="https://repo.ceereals.space"
license=('GPL-3.0-or-later')

# The post-install script that calls pacman-key.
install=shokunin-keyring.install

# Two files make up a pacman "keyring":
#   - shokunin.gpg    : the exported keys (GPG keyring file)
#   - shokunin-trusted: a list of long key IDs to lsign (one per line)
#   - shokunin-revoked: optional, long key IDs to revoke (one per line)
#
# Both files are PLACEHOLDERS in-tree. The real exported keyring is
# generated by `repo/scripts/export-keyring.sh` (TODO) and shipped via
# CI on key bumps. NEVER commit a real private key.
source=(
  'shokunin.gpg'
  'shokunin-trusted'
)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm644 "${srcdir}/shokunin.gpg" \
    "${pkgdir}/usr/share/pacman/keyrings/shokunin.gpg"
  install -Dm644 "${srcdir}/shokunin-trusted" \
    "${pkgdir}/usr/share/pacman/keyrings/shokunin-trusted"
}
